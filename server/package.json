{
  "name": "starcore-api",
  "version": "1.0.0",
  "description": "StarCore CMS — contract & invoice management API",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm install --include=dev",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node --import tsx --test src/services/workflows/workflows.test.ts",
    "migrate": "psql -f migrations/schema.sql"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^10.4.0",
    "openai": "^7.53.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
