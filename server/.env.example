PORT=4000
NODE_ENV=development
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# OmniRoute Cloud Tunnel (for example https://your-tunnel.trycloudflare.com/v1)
OMNIROUTE_API_URL=
# OmniRoute Auth Key
OMNIROUTE_API_KEY=

# SMTP (Gmail users should use an app password when 2-Step Verification is enabled)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# WhatsApp Cloud API: use the full messages endpoint URL for your phone number ID
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=

# OAuth sender profiles (Gmail / WhatsApp).
# Create these in Google Cloud Console (OAuth client, Gmail API enabled) and
# Meta for Developers (WhatsApp Business app); the API redirects back to
# <FRONTEND_URL>/api/senders/oauth/<provider>/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
# AES key used to encrypt stored OAuth tokens (any long random string).
SENDER_TOKEN_ENCRYPTION_KEY=
# Optional: public origin for OAuth callbacks when it differs from FRONTEND_URL.
OAUTH_REDIRECT_BASE=
